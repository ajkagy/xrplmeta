	"definitions": {
		"Operation": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"subjectType": {
					"type": "string",
					"enum": [
						"global",
						"issuer",
						"token"
					]
				},
				"subjectId": {
					"type": "integer"
				},
				"task": {
					"type": "string"
				},
				"time": {
					"type": "integer"
				}
			},
			"required": [
				"subjectType",
				"subjectId",
				"task",
				"time"
			],
			"unique": [
				["subjectType", "subjectId", "task"]
			]
		},
		"Snapshot": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"creationTime": {
					"type": "integer"
				},
				"completionTime": {
					"type": "integer"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"entriesCount": {
					"type": "integer",
					"default": 0
				},
				"originNode": {
					"type": "string"
				},
				"marker": {
					"type": "any"
				}
			},
			"required": [
				"creationTime",
				"ledgerSequence"
			],
			"unique": [
				"ledgerSequence"
			]
		},
		"Ledger": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"sequence": {
					"type": "integer"
				},
				"hash": {
					"type": "string",
					"format": "hex"
				},
				"closeTime": {
					"type": "integer",
					"format": "timestamp"
				},
				"txCount": {
					"type": "integer"
				},
				"txTypeCounts": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/LedgerTxTypeCount"
					}
				},
				"minFee": {
					"type": "integer"
				},
				"maxFee": {
					"type": "integer"
				},
				"avgFee": {
					"type": "integer"
				}
			},
			"required": [
				"sequence",
				"hash",
				"closeTime",
				"txCount"
			],
			"unique": [
				"sequence"
			],
			"index": [
				"closeTime"
			]
		},
		"LedgerTxTypeCount": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"ledger": {
					"$ref": "#/definitions/Ledger"
				},
				"type": {
					"type": "string"
				},
				"count": {
					"type": "integer"
				}
			},
			"unique": [
				["ledger", "type"]
			],
			"required": [
				"ledger",
				"type",
				"count"
			]
		},
		"Account": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"address": {
					"type": "string",
					"format": "xrpl/address"
				},
				"domain": {
					"type": "string"
				},
				"emailHash": {
					"type": "string",
					"format": "hex"
				},
				"transferRate": {
					"type": "integer"
				},
				"blackholed": {
					"type": "boolean"
				},
				"pseudo": {
					"type": "boolean"
				},
				"pseudoSource": {
					"type": "string"
				},
				"props": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/AccountProp"
					}
				}
			},
			"required": [
				"address"
			],
			"unique": [
				"address"
			]
		},
		"AccountProp": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"account": {
					"$ref": "#/definitions/Account"
				},
				"key": {
					"type": "string"
				},
				"value": {
					"type": "any"
				},
				"source": {
					"type": "string"
				}
			},
			"required": [
				"account",
				"key",
				"source"
			],
			"unique": [
				["account", "key", "source"]
			]
		},
		"AccountBalance": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"account": {
					"$ref": "#/definitions/Account"
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"balance": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": 0
				}
			},
			"required": [
				"account",
				"token",
				"ledgerSequence"
			],
			"unique": [
				["token", "account", "ledgerSequence:desc"]
			]
		},
		"Token": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"issuer": {
					"$ref": "#/definitions/Account"
				},
				"currency": {
					"type": "string",
					"format": "xrpl/currency"
				},
				"mptIssuanceId": {
					"type": "string"
				},
				"tokenType": {
					"type": "string",
					"enum": [
						"XRP",
						"IOU",
						"MPT"
					]				
				},
				"props": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/TokenProp"
					}
				}
			},
			"required": [
				"tokenType"
			],
			"unique": [
				["issuer", "currency"],
				["mptIssuanceId"]
			]
		},
		"TokenProp": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"key": {
					"type": "string"
				},
				"value": {
					"type": "any"
				},
				"source": {
					"type": "string"
				}
			},
			"required": [
				"token",
				"key",
				"source"
			],
			"unique": [
				["token", "key", "source"]
			]
		},
		"TokenExchange": {
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"txHash": {
					"type": "string",
					"format": "hex"
				},
				"maker": {
					"$ref": "#/definitions/Account"
				},
				"taker": {
					"$ref": "#/definitions/Account"
				},
				"sequence": {
					"type": "integer"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"takerPaidToken": {
					"$ref": "#/definitions/Token"
				},
				"takerGotToken": {
					"$ref": "#/definitions/Token"
				},
				"takerPaidValue": {
					"type": "string",
					"format": "xrpl/xfl"
				},
				"takerGotValue": {
					"type": "string",
					"format": "xrpl/xfl"
				}
			},
			"required": [
				"txHash",
				"maker",
				"taker",
				"ledgerSequence",
				"takerPaidValue",
				"takerGotValue"
			],
			"unique": [
				["txHash", "maker", "sequence"]
			],
			"index": [
				["takerPaidToken", "takerGotToken", "ledgerSequence:asc"],
				["takerPaidToken", "takerGotToken", "ledgerSequence:desc"]
			]
		},
		"TokenSupply": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"value": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": 0
				}
			},
			"required": [
				"token",
				"ledgerSequence"
			],
			"unique": [
				["token", "ledgerSequence:asc"],
				["token", "ledgerSequence:desc"]
			]
		},
		"TokenTrustlines": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"value": {
					"type": "integer",
					"default": 0
				}
			},
			"required": [
				"token",
				"ledgerSequence"
			],
			"unique": [
				["token", "ledgerSequence:asc"],
				["token", "ledgerSequence:desc"]
			]
		},
		"TokenHolders": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"value": {
					"type": "integer",
					"default": 0
				}
			},
			"required": [
				"token",
				"ledgerSequence"
			],
			"unique": [
				["token", "ledgerSequence:asc"],
				["token", "ledgerSequence:desc"]
			]
		},
		"TokenMarketcap": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"value": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": 0
				}
			},
			"required": [
				"token",
				"ledgerSequence"
			],
			"unique": [
				["token", "ledgerSequence:asc"],
				["token", "ledgerSequence:desc"]
			]
		},
		"TokenBook": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"takerPays": {
					"$ref": "#/definitions/Token"
				},
				"takerGets": {
					"$ref": "#/definitions/Token"
				}
			},
			"required": [
				"takerPays",
				"takerGets"
			],
			"unique": [
				["takerGets", "takerPays"]
			],
			"index": [
				"takerPays"
			]
		},
		"TokenOffer": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"account": {
					"$ref": "#/definitions/Account"
				},
				"accountSequence": {
					"type": "integer"
				},
				"book": {
					"$ref": "#/definitions/TokenBook"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"lastLedgerSequence": {
					"type": "integer"
				},
				"quality": {
					"type": "string",
					"format": "xrpl/xfl"
				},
				"size": {
					"type": "string",
					"format": "xrpl/xfl"
				},
				"expirationTime": {
					"type": "integer"
				}
			},
			"required": [
				"account",
				"accountSequence",
				"book",
				"quality",
				"size",
				"ledgerSequence",
				"lastLedgerSequence"
			],
			"unique": [
				["account", "accountSequence", "ledgerSequence:desc"]
			],
			"index": [
				["book", "ledgerSequence", "lastLedgerSequence", "quality"]
			]
		},
		"NFTokenCollection": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"issuer": {
					"$ref": "#/definitions/Account"
				},
				"taxon": {
					"type": "integer"
				},
				"firstSeenLedger": {
					"type": "integer"
				}
			},
			"required": [
				"issuer",
				"taxon"
			],
			"unique": [
				["issuer", "taxon"]
			]
		},
		"NFToken": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"issuer": {
					"$ref": "#/definitions/Account"
				},
				"owner": {
					"$ref": "#/definitions/Account"
				},
				"collection": {
					"$ref": "#/definitions/NFTokenCollection"
				},
				"tokenId": {
					"type": "string",
					"format": "hex"
				},
				"taxon": {
					"type": "integer"
				},
				"flags": {
					"type": "integer"
				},
				"transferFee": {
					"type": "integer"
				},
				"serial": {
					"type": "integer"
				},
				"mintLedgerSequence": {
					"type": "integer"
				},
				"burnLedgerSequence": {
					"type": "integer"
				},
				"uri": {
					"type": "string"
				}
			},
			"required": [
				"issuer",
				"tokenId"
			],
			"unique": [
				"tokenId"
			],
			"index": [
				["collection"]
			]
		},
		"NFTokenOffer": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"account": {
					"$ref": "#/definitions/Account"
				},
				"offerId": {
					"type": "string",
					"format": "hex"
				},
				"nft": {
					"$ref": "#/definitions/NFToken"
				},
				"collection": {
					"$ref": "#/definitions/NFTokenCollection"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"lastLedgerSequence": {
					"type": "integer"
				},
				"amountToken": {
					"$ref": "#/definitions/Token"
				},
				"amountValue": {
					"type": "string",
					"format": "xrpl/xfl"
				},
				"isSellOffer": {
					"type": "boolean"
				},
				"destination": {
					"$ref": "#/definitions/Account"
				},
				"expirationTime": {
					"type": "integer"
				}
			},
			"required": [
				"account",
				"offerId",
				"nft",
				"ledgerSequence",
				"lastLedgerSequence"
			],
			"unique": [
				"offerId"
			],
			"index": [
				["nft", "ledgerSequence:desc", "lastLedgerSequence"],
				["collection", "isSellOffer", "lastLedgerSequence"]
			]
		},
		"NFTokenExchange": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"txHash": {
					"type": "string",
					"format": "hex"
				},
				"account": {
					"$ref": "#/definitions/Account"
				},
				"offer": {
					"$ref": "#/definitions/NFTokenOffer"
				},
				"nft": {
					"$ref": "#/definitions/NFToken"
				},
				"collection": {
					"$ref": "#/definitions/NFTokenCollection"
				},
				"seller": {
					"$ref": "#/definitions/Account"
				},
				"buyer": {
					"$ref": "#/definitions/Account"
				},
				"amountToken": {
					"$ref": "#/definitions/Token"
				},
				"amountValue": {
					"type": "string",
					"format": "xrpl/xfl"
				},
				"isSellOffer": {
					"type": "boolean"
				},
				"ledgerSequence": {
					"type": "integer"
				}
			},
			"required": [
				"txHash",
				"account",
				"offer",
				"nft",
				"ledgerSequence"
			],
			"unique": [
				"txHash"
			],
			"index": [
				["nft", "ledgerSequence"],
					["collection", "ledgerSequence"]
			]
		},
		"MPTokenMetadataUpdate": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"token": {
					"$ref": "#/definitions/Token"
				},
				"ledgerSequence": {
					"type": "integer"
				},
				"transactionIndex": {
					"type": "integer"
				},
				"deleted": {
					"type": "boolean",
					"default": false
				}
			},
			"required": [
				"token"
			],
			"unique": [
				"token"
			],
			"index": [
				["deleted"]
			]
		},
		"UnknownLedgerEntryType": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"type": {
					"type": "string"
				},
				"firstSeenLedger": {
					"type": "integer"
				},
				"lastSeenLedger": {
					"type": "integer"
				},
				"count": {
					"type": "integer",
					"default": 0
				}
			},
			"required": [
				"type"
			],
			"unique": [
				"type"
			]
		},
		"AmmPool": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
