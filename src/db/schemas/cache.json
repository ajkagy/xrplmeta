{
	"title": "XRPL Meta Cache Database Structure",
	"type": "object",
	"properties": {
		"tokens": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/Token"
			}
		},
		"nftCollections": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/NFTokenCollection"
			}
		},
		"nftMeta": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/NFTMeta"
			}
		},
		"nftMedia": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/NFTMedia"
			}
		},
		"icons": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/Icon"
			}
		},
		"iconUsers": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/IconUser"
			}
		},
		"todos": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/Todo"
			}
		}
	},
	"definitions": {
		"Token": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"tokenType": {
					"type": "string",
					"enum": [
						"XRP",
						"IOU",
						"MPT"
					]				
				},
				"token": {
					"type": "integer"
				},
				"tokenCurrencyHex": {
					"type": "string"
				},
				"tokenCurrencyUtf8": {
					"type": "string"
				},
				"mptIssuanceId": {
					"type": "string"
				},
				"tokenName": {
					"type": "string"
				},
				"tokenProps": {
					"type": "any"
				},
				"issuerAddress": {
					"type": "string"
				},
				"issuerName": {
					"type": "string"
				},
				"issuerProps": {
					"type": "any"
				},
				"issuerPseudo": {
					"type": "boolean",
					"default": false
				},
				"issuerPseudoSource": {
					"type": "string"
				},
				"cachedIcons": {
					"type": "any"
				},
				"trustLevel": {
					"type": "integer",
					"default": 0
				},
				"trustlines": {
					"type": "integer",
					"default": 0
				},
				"trustlinesDelta24H": {
					"type": "integer",
					"default": 0
				},
				"trustlinesPercent24H": {
					"type": "number",
					"default": 0
				},
				"trustlinesDelta7D": {
					"type": "integer",
					"default": 0
				},
				"trustlinesPercent7D": {
					"type": "number",
					"default": 0
				},
				"holders": {
					"type": "integer",
					"default": 0
				},
				"holdersDelta24H": {
					"type": "integer",
					"default": 0
				},
				"holdersPercent24H": {
					"type": "number",
					"default": 0
				},
				"holdersDelta7D": {
					"type": "integer",
					"default": 0
				},
				"holdersPercent7D": {
					"type": "number",
					"default": 0
				},
				"supply": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"supplyDelta24H": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"supplyPercent24H": {
					"type": "number",
					"default": 0
				},
				"supplyDelta7D": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"supplyPercent7D": {
					"type": "number",
					"default": 0
				},
				"marketcap": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"marketcapDelta24H": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"marketcapPercent24H": {
					"type": "number",
					"default": 0
				},
				"marketcapDelta7D": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"marketcapPercent7D": {
					"type": "number",
					"default": 0
				},
				"price": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"pricePercent24H": {
					"type": "number",
					"default": 0
				},
				"pricePercent7D": {
					"type": "number",
					"default": 0
				},
				"volume24H": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"volume7D": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"exchanges24H": {
					"type": "integer",
					"default": 0
				},
				"exchanges7D": {
					"type": "integer",
					"default": 0
				},
				"takers24H": {
					"type": "integer",
					"default": 0
				},
				"takers7D": {
					"type": "integer",
					"default": 0
				}
			},
			"required": [
				"token",
				"issuerAddress",
				"tokenType"
			],
			"unique": [
				"token"
			],
			"index": [
				"tokenCurrencyHex",
				"tokenName",
				"issuerAddress",
				"issuerName",
				"issuerPseudo",
				"trustLevel",
				"trustlines",
				"trustlinesDelta24H",
				"trustlinesPercent24H",
				"trustlinesDelta7D",
				"trustlinesPercent7D",
				"holders",
				"holdersDelta24H",
				"holdersPercent24H",
				"holdersDelta7D",
				"holdersPercent7D",
				"supply",
				"supplyDelta24H",
				"supplyPercent24H",
				"supplyDelta7D",
				"supplyPercent7D",
				"marketcap",
				"marketcapDelta24H",
				"marketcapPercent24H",
				"marketcapDelta7D",
				"marketcapPercent7D",
				"price",
				"pricePercent24H",
				"pricePercent7D",
				"volume24H",
				"volume7D",
				"exchanges24H",
				"exchanges7D",
				"takers24H",
				"takers7D"
			]
		},
		"NFTokenCollection": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"collection": {
					"type": "integer"
				},
				"issuerAddress": {
					"type": "string"
				},
				"taxon": {
					"type": "integer"
				},
				"name": {
					"type": "string"
				},
				"imageUrl": {
					"type": "string"
				},
				"enrichedTime": {
					"type": "integer"
				},
				"supply": {
					"type": "integer",
					"default": 0
				},
				"holders": {
					"type": "integer",
					"default": 0
				},
				"floor": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"volume24H": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"volume7D": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"volumeAll": {
					"type": "string",
					"format": "xrpl/xfl",
					"default": "0"
				},
				"trades24H": {
					"type": "integer",
					"default": 0
				},
				"trades7D": {
					"type": "integer",
					"default": 0
				}
			},
			"required": [
				"collection",
				"issuerAddress",
				"taxon"
			],
			"unique": [
				"collection"
			],
			"index": [
				"issuerAddress",
				"taxon",
				"supply",
				"holders",
				"floor",
				"volume24H",
				"volume7D",
				"volumeAll",
				"trades24H",
				"trades7D"
			]
		},
		"NFTMeta": {
			"type": "object",
			"properties": {
				"id": { "type": "integer", "id": true },
				"tokenId": { "type": "string" },
				"name": { "type": "string" },
				"description": { "type": "string" },
				"mediaUrl": { "type": "string" },
				"mediaType": { "type": "string" },
				"imageUrl": { "type": "string" },
				"fetchedTime": { "type": "integer" },
				"error": { "type": "string" }
			},
			"required": [ "tokenId" ],
			"unique": [ "tokenId" ]
		},
		"NFTMedia": {
			"type": "object",
			"properties": {
				"id": { "type": "integer", "id": true },
				"hash": { "type": "string" },
				"sourceUrl": { "type": "string" },
				"fileType": { "type": "string" },
				"sizeBytes": { "type": "integer", "default": 0 },
				"lastAccess": { "type": "integer" },
				"timeCreated": { "type": "integer" }
			},
			"required": [ "hash", "sourceUrl" ],
			"unique": [ "hash" ],
			"index": [ "lastAccess", "sourceUrl" ]
		},
		"Icon": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"url": {
					"type": "string"
				},
				"hash": {
					"type": "string"
				},
				"fileType": {
					"type": "string"
				},
				"timeUpdated": {
					"type": "integer"
				},
				"error": {
					"type": "string"
				},
				"users": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/IconUser"
					}
				}
			},
			"required": [
				"url"
			],
			"unique": [
				"url"
			],
			"index": [
				"timeUpdated"
			]
		},
		"IconUser": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"icon": {
					"$ref": "#/definitions/Icon"
				},
				"userType": {
					"type": "string",
					"enum": [
						"account",
						"token"
					]
				},
				"userId": {
					"type": "integer"
				}
			},
			"required": [
				"icon",
				"userType",
				"userId"
			],
			"unique": [
				["icon", "userType", "userId"]
			],
			"index": [
				["userType", "userId"]
			]
		},
		"Todo": {
			"type": "object",
			"properties": {
				"id": {
					"type": "integer",
					"id": true
				},
				"task": {
					"type": "string",
					"enum": [
						"account.props",
						"account.icons",
						"token.props",
						"token.exchanges",
						"token.metrics.trustlines",
						"token.metrics.holders",
						"token.metrics.supply",
						"token.metrics.marketcap",
						"token.icons",
						"nftCollection.metrics"
					]
				},
				"subject": {
					"type": "integer"
				}
			},
			"required": [
				"task",
				"subject"
			],
			"unique": [
				["task", "subject"]
			],
			"index": [
				"task"
			]
		}
	}
}