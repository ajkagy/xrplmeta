{
	"name": "beacon",
	"version": "1.0.0",
	"description": "Beacon — a full-featured XRP Ledger metadata, asset, and NFT discovery indexer with a REST/WebSocket API. Forked from xrplmeta (https://github.com/xrplmeta/node).",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"bin": {
		"beacon": "./src/run.js"
	},
	"scripts": {
		"start": "node src/run.js",
		"postinstall": "node scripts/check-buildtools.js && node-gyp rebuild --directory=deps --release",
		"build-deps": "node-gyp rebuild --directory=deps --release",
		"test": "mocha --recursive 'test/unit/**/*.test.js'",
		"livetest": "node test/live/run.js"
	},
	"dependencies": {
		"@koa/router": "15.4.0",
		"better-sqlite3": "12.9.0",
		"koa": "3.2.0",
		"koa-easy-ws": "2.1.0",
		"koa-json": "2.0.2",
		"koa-send": "5.0.1",
		"limiter": "3.0.0",
		"ripple-address-codec": "5.0.0",
		"sharp": "0.34.5",
		"smol-toml": "1.6.1",
		"ws": "8.20.0"
	},
	"devDependencies": {
		"chai": "6.2.2",
		"mocha": "11.7.5"
	}
}
